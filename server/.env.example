# Đấu Trường Nhân Quả — M2 online server
# Copy to .env on Render (Environment tab) or locally. NEVER commit a real .env.
# Fill after creating the Supabase project + Render service (see docs/online-architecture.md).

# Supabase project URL, e.g. https://xyzcompany.supabase.co
SUPABASE_URL=
# Supabase anon (public) key — safe to embed in the client, used only for Auth here
SUPABASE_ANON_KEY=
# Supabase SERVICE ROLE key — SERVER ONLY. Never put this in the Godot client or git.
SUPABASE_SERVICE_ROLE_KEY=

# Port Colyseus listens on. Render injects PORT automatically; this is the local fallback.
COLYSEUS_PORT=2567

# Comma-separated list of allowed client origins for the health endpoint / CORS notes.
# Example: https://dau-truong-nhan-qua.onrender.com
ALLOWED_ORIGINS=

# Optional: shared secret used only by internal tooling (balance reload, admin endpoints).
# Do not reuse the Supabase service-role key here.
ADMIN_TOKEN=
