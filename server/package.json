{
  "dependencies": {
    "@colyseus/schema": "^2.0.0",
    "@colyseus/ws-transport": "^0.15.0",
    "@supabase/supabase-js": "^2.45.0",
    "colyseus": "^0.15.0",
    "dotenv": "^16.4.0"
  },
  "description": "Colyseus game server (M2 online) for Đấu Trường Nhân Quả — Render + Supabase. M1 stays offline in Godot; this server is the authoritative multiplayer backend.",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.0",
    "colyseus.js": "^0.15.28",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "name": "dau-truong-nhan-qua-server",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "ts-node --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "ts-node --transpile-only src/__tests__/smoke.ts",
    "test:e2e": "ts-node --transpile-only src/__tests__/e2e.ts"
  },
  "version": "0.1.0"
